{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cs-router",
  "version": "1.0.0",
  "identifier": "io.github.yuntao.cs-router",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CS Router",
        "width": 1000,
        "height": 650,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
